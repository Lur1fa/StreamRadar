APP_NAME=StreamRadar
# Secure defaults. Use APP_ENV=local / APP_DEBUG=true only on a private
# development machine: debug pages reveal code and request data.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL of the app. When it starts with https:// (TLS reverse proxy in
# front) every link and redirect is built from this value, whatever address the
# request came in on, and the session cookie is marked Secure. The app is then
# only usable through that URL.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true   # forced on automatically when APP_URL starts with https://

# Comma separated IPs or CIDR ranges of reverse proxies whose X-Forwarded-*
# headers may be trusted ("*" = any). Set this behind a proxy so the real client
# IP is used for login throttling and logs, e.g. 172.16.0.0/12 for Docker networks.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Authentication ──────────────────────────────────────────────────────────
# Authentication is always required. The first administrator is created with
# the one-time token printed by `php artisan auth:setup-token` (the Docker
# entrypoint prints it on first start) or with `php artisan user:create --admin`.
# There is no default account and no default password.

# Allow e-mail + password sign-in. Keep enabled unless SSO is configured; the
# console commands always work regardless of this flag.
AUTH_LOCAL_LOGIN=true
AUTH_PASSWORD_MIN_LENGTH=12

# ── OpenID Connect single sign-on (optional) ────────────────────────────────
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email"
# OIDC_REDIRECT_URI=            # defaults to ${APP_URL}/auth/oidc/callback
# OIDC_BUTTON_LABEL="Sign in with SSO"
OIDC_AUTO_PROVISION=true        # create accounts on first SSO login (default until changed on the Users page)
OIDC_LINK_BY_EMAIL=true         # link to an existing account with a verified matching e-mail
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# Role mapping: members of these groups (claim OIDC_ADMIN_CLAIM) or these e-mails become admins.
# The provider must actually send that claim: add the scope that releases it to
# OIDC_SCOPES (Authelia and Keycloak: "groups") and allow it on the client.
OIDC_ADMIN_CLAIM=groups
# OIDC_ADMIN_VALUES=streamradar-admins
# OIDC_ADMIN_EMAILS=
OIDC_FIRST_USER_ADMIN=false     # make the very first SSO user an admin (only on a private IdP!)

# ── Outbound webhook policy (SSRF protection) ───────────────────────────────
# Webhook targets may only resolve to public addresses. List exact hostnames
# here to allow a self-hosted endpoint on your LAN, e.g. ntfy.home.lan
# WEBHOOK_ALLOWED_HOSTS=

# ── Developer tooling ───────────────────────────────────────────────────────
# Inertia DevTools are off unless explicitly enabled AND never in production.
INERTIA_DEVTOOLS_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: Twitch credentials via environment instead of the Settings page.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SYNC_FREQUENCY_MINUTES=5

VITE_APP_NAME="${APP_NAME}"
